{
  "name": "titan-design",
  "private": true,
  "version": "0.0.1",
  "author": "Henry Jewkes",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/HJewkes/titan-design.git"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "storybook": "turbo run storybook",
    "build-storybook": "turbo run build-storybook",
    "type-check": "turbo run type-check",
    "format:check": "turbo run format:check",
    "check:package": "turbo run check:package",
    "arch:check": "pnpm --filter @titan-design/react-ui exec vitest run src/arch/arch-graph.freshness.test.ts",
    "verify": "pnpm format:check && pnpm lint && pnpm type-check && pnpm build && turbo run test -- --run --coverage && pnpm arch:check",
    "arch:graph": "node scripts/arch-graph.mjs",
    "review": "node packages/review-harness/src/cli.ts"
  },
  "devDependencies": {
    "turbo": "^2.3.0"
  },
  "pnpm": {
    "overrides": {
      "shell-quote@<1.8.4": "^1.8.4"
    }
  }
}
