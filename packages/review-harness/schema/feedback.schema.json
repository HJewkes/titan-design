{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "titan-review/feedback@1"
    },
    "unit": {
      "type": "string"
    },
    "round": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "manifestSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "submittedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "answers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "questionId": {
            "type": "string"
          },
          "pick": {
            "type": "string"
          },
          "picks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "value": {
            "type": "number"
          },
          "text": {
            "type": "string"
          },
          "comment": {
            "type": "string"
          },
          "variantComments": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string"
                },
                "comment": {
                  "type": "string"
                }
              },
              "required": [
                "key",
                "comment"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "questionId"
        ],
        "additionalProperties": false
      }
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "storyId": {
            "type": "string"
          },
          "verdict": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "chosen",
                  "rejected",
                  "maybe"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "comment": {
            "type": "string"
          },
          "annotations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "width": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "xPct": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "yPct": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "target": {
                  "type": "object",
                  "properties": {
                    "testId": {
                      "type": "string"
                    },
                    "role": {
                      "type": "string"
                    },
                    "text": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                },
                "note": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "width",
                "x",
                "y",
                "xPct",
                "yPct",
                "note"
              ],
              "additionalProperties": false
            }
          },
          "relatedQuestionIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "key",
          "storyId",
          "verdict",
          "comment",
          "annotations"
        ],
        "additionalProperties": false
      }
    },
    "general": {
      "type": "string"
    }
  },
  "required": [
    "schema",
    "unit",
    "round",
    "manifestSha256",
    "submittedAt",
    "answers",
    "variants",
    "general"
  ],
  "additionalProperties": false
}
