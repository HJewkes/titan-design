{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "titan-review/round@1"
    },
    "unit": {
      "type": "string",
      "minLength": 1
    },
    "round": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "storybookUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://(127\\.0\\.0\\.1|localhost|\\[::1\\])(:[0-9]+)?(/.*)?$"
    },
    "context": {
      "type": "string"
    },
    "widths": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 200,
        "maximum": 3840
      }
    },
    "height": {
      "default": "auto",
      "anyOf": [
        {
          "type": "integer",
          "minimum": 120,
          "maximum": 4000
        },
        {
          "type": "string",
          "const": "auto"
        }
      ]
    },
    "maxHeight": {
      "default": 1200,
      "type": "integer",
      "minimum": 120,
      "maximum": 4000
    },
    "variants": {
      "minItems": 1,
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,32}$"
          },
          "storyId": {
            "type": "string",
            "pattern": "^[a-z0-9-]+--[a-z0-9-]+$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "args": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                }
              ]
            }
          },
          "globals": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                }
              ]
            }
          },
          "height": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 120,
                "maximum": 4000
              },
              {
                "type": "string",
                "const": "auto"
              }
            ]
          }
        },
        "required": [
          "key",
          "storyId",
          "label"
        ],
        "additionalProperties": false
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,32}$"
              },
              "prompt": {
                "type": "string",
                "minLength": 1
              },
              "required": {
                "type": "boolean"
              },
              "scope": {
                "type": "string",
                "enum": [
                  "variant",
                  "round"
                ]
              },
              "kind": {
                "type": "string",
                "const": "pick-one"
              },
              "options": {
                "minItems": 2,
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "optionVariants": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,32}$"
                }
              }
            },
            "required": [
              "id",
              "prompt",
              "kind",
              "options"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,32}$"
              },
              "prompt": {
                "type": "string",
                "minLength": 1
              },
              "required": {
                "type": "boolean"
              },
              "scope": {
                "type": "string",
                "enum": [
                  "variant",
                  "round"
                ]
              },
              "kind": {
                "type": "string",
                "const": "pick-many"
              },
              "options": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "optionVariants": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,32}$"
                }
              }
            },
            "required": [
              "id",
              "prompt",
              "kind",
              "options"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,32}$"
              },
              "prompt": {
                "type": "string",
                "minLength": 1
              },
              "required": {
                "type": "boolean"
              },
              "scope": {
                "type": "string",
                "enum": [
                  "variant",
                  "round"
                ]
              },
              "kind": {
                "type": "string",
                "const": "scale"
              },
              "min": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "max": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "id",
              "prompt",
              "kind",
              "min",
              "max"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,32}$"
              },
              "prompt": {
                "type": "string",
                "minLength": 1
              },
              "required": {
                "type": "boolean"
              },
              "scope": {
                "type": "string",
                "enum": [
                  "variant",
                  "round"
                ]
              },
              "kind": {
                "type": "string",
                "const": "text"
              }
            },
            "required": [
              "id",
              "prompt",
              "kind"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "sections": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,32}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "context": {
            "type": "string"
          },
          "questionIds": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,32}$"
            }
          },
          "variantKeys": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,32}$"
            }
          },
          "seeAlso": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,32}$"
            }
          },
          "height": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 120,
                "maximum": 4000
              },
              {
                "type": "string",
                "const": "auto"
              }
            ]
          }
        },
        "required": [
          "id",
          "title"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "unit",
    "round",
    "storybookUrl",
    "widths",
    "variants",
    "questions"
  ],
  "additionalProperties": false
}
