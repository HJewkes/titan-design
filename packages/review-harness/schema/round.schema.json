{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "titan-review/round@1"
    },
    "unit": {
      "type": "string",
      "minLength": 1
    },
    "round": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "storybookUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://(127\\.0\\.0\\.1|localhost|\\[::1\\])(:[0-9]+)?(/.*)?$"
    },
    "context": {
      "type": "string"
    },
    "widths": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 200,
        "maximum": 3840
      }
    },
    "height": {
      "default": "auto",
      "anyOf": [
        {
          "type": "integer",
          "minimum": 120,
          "maximum": 4000
        },
        {
          "type": "string",
          "const": "auto"
        }
      ]
    },
    "maxHeight": {
      "default": 1200,
      "type": "integer",
      "minimum": 120,
      "maximum": 4000
    },
    "variants": {
      "minItems": 1,
      "maxItems": 80,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,32}$"
          },
          "storyId": {
            "type": "string",
            "pattern": "^[a-z0-9-]+--[a-z0-9-]+$"
          },
          "image": {
            "type": "string",
            "pattern": "^(?![/\\\\]|[A-Za-z]:)(?!(.*[/\\\\])?\\.\\.([/\\\\]|$)).+\\.[Pp][Nn][Gg]$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "args": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                }
              ]
            }
          },
          "globals": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                }
              ]
            }
          },
          "height": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 120,
                "maximum": 4000
              },
              {
                "type": "string",
                "const": "auto"
              }
            ]
          }
        },
        "required": ["key", "label"],
        "additionalProperties": false,
        "oneOf": [
          {
            "required": ["storyId"]
          },
          {
            "required": ["image"],
            "not": {
              "anyOf": [
                {
                  "required": ["args"]
                },
                {
                  "required": ["globals"]
                }
              ]
            }
          }
        ]
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,32}$"
              },
              "prompt": {
                "type": "string",
                "minLength": 1
              },
              "required": {
                "type": "boolean"
              },
              "scope": {
                "type": "string",
                "enum": ["variant", "round"]
              },
              "kind": {
                "type": "string",
                "const": "pick-one"
              },
              "options": {
                "minItems": 2,
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "optionVariants": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,32}$"
                }
              },
              "recommendation": {
                "type": "object",
                "properties": {
                  "answer": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "minItems": 1,
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      {
                        "type": "number"
                      }
                    ]
                  },
                  "rationale": {
                    "type": "string",
                    "minLength": 1
                  },
                  "confidence": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "by": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["answer", "rationale", "confidence", "by"],
                "additionalProperties": false
              }
            },
            "required": ["id", "prompt", "kind", "options"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,32}$"
              },
              "prompt": {
                "type": "string",
                "minLength": 1
              },
              "required": {
                "type": "boolean"
              },
              "scope": {
                "type": "string",
                "enum": ["variant", "round"]
              },
              "kind": {
                "type": "string",
                "const": "pick-many"
              },
              "options": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "optionVariants": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,32}$"
                }
              },
              "recommendation": {
                "type": "object",
                "properties": {
                  "answer": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "minItems": 1,
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      {
                        "type": "number"
                      }
                    ]
                  },
                  "rationale": {
                    "type": "string",
                    "minLength": 1
                  },
                  "confidence": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "by": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["answer", "rationale", "confidence", "by"],
                "additionalProperties": false
              }
            },
            "required": ["id", "prompt", "kind", "options"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,32}$"
              },
              "prompt": {
                "type": "string",
                "minLength": 1
              },
              "required": {
                "type": "boolean"
              },
              "scope": {
                "type": "string",
                "enum": ["variant", "round"]
              },
              "kind": {
                "type": "string",
                "const": "scale"
              },
              "min": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "max": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "recommendation": {
                "type": "object",
                "properties": {
                  "answer": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "minItems": 1,
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      {
                        "type": "number"
                      }
                    ]
                  },
                  "rationale": {
                    "type": "string",
                    "minLength": 1
                  },
                  "confidence": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "by": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["answer", "rationale", "confidence", "by"],
                "additionalProperties": false
              }
            },
            "required": ["id", "prompt", "kind", "min", "max"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,32}$"
              },
              "prompt": {
                "type": "string",
                "minLength": 1
              },
              "required": {
                "type": "boolean"
              },
              "scope": {
                "type": "string",
                "enum": ["variant", "round"]
              },
              "kind": {
                "type": "string",
                "const": "text"
              }
            },
            "required": ["id", "prompt", "kind"],
            "additionalProperties": false
          }
        ]
      }
    },
    "sections": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,32}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "context": {
            "type": "string"
          },
          "questionIds": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,32}$"
            }
          },
          "variantKeys": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,32}$"
            }
          },
          "seeAlso": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,32}$"
            }
          },
          "height": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 120,
                "maximum": 4000
              },
              {
                "type": "string",
                "const": "auto"
              }
            ]
          },
          "contrast": {
            "type": "object",
            "properties": {
              "knownDefects": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "variant": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]{1,32}$"
                    },
                    "mode": {
                      "type": "string",
                      "enum": ["light", "dark"]
                    },
                    "kind": {
                      "type": "string",
                      "enum": ["text", "large-text", "non-text"]
                    },
                    "element": {
                      "type": "string",
                      "minLength": 1
                    },
                    "route": {
                      "type": "string",
                      "pattern": "^([A-Z][A-Z0-9]*-[0-9]+[a-z]?|component)$"
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": ["route", "reason"],
                  "additionalProperties": false
                }
              },
              "measured": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "variant": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]{1,32}$"
                    },
                    "mode": {
                      "type": "string",
                      "enum": ["light", "dark"]
                    },
                    "kind": {
                      "type": "string",
                      "enum": ["text", "large-text", "non-text"]
                    },
                    "element": {
                      "type": "string",
                      "minLength": 1
                    },
                    "ratio": {
                      "type": "number",
                      "minimum": 1,
                      "maximum": 21
                    },
                    "source": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": ["variant", "mode", "kind", "element", "ratio", "source"],
                  "additionalProperties": false
                }
              },
              "unmeasured": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "variant": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]{1,32}$"
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": ["variant", "reason"],
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "required": ["id", "title"],
        "additionalProperties": false
      }
    },
    "recommendations": {
      "default": "after-answer",
      "type": "string",
      "enum": ["after-answer", "shown"]
    },
    "contrast": {
      "type": "object",
      "properties": {
        "knownDefects": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "variant": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,32}$"
              },
              "mode": {
                "type": "string",
                "enum": ["light", "dark"]
              },
              "kind": {
                "type": "string",
                "enum": ["text", "large-text", "non-text"]
              },
              "element": {
                "type": "string",
                "minLength": 1
              },
              "route": {
                "type": "string",
                "pattern": "^([A-Z][A-Z0-9]*-[0-9]+[a-z]?|component)$"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["route", "reason"],
            "additionalProperties": false
          }
        },
        "measured": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "variant": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,32}$"
              },
              "mode": {
                "type": "string",
                "enum": ["light", "dark"]
              },
              "kind": {
                "type": "string",
                "enum": ["text", "large-text", "non-text"]
              },
              "element": {
                "type": "string",
                "minLength": 1
              },
              "ratio": {
                "type": "number",
                "minimum": 1,
                "maximum": 21
              },
              "source": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["variant", "mode", "kind", "element", "ratio", "source"],
            "additionalProperties": false
          }
        },
        "unmeasured": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "variant": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,32}$"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["variant", "reason"],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["schema", "unit", "round", "storybookUrl", "widths", "variants", "questions"],
  "additionalProperties": false,
  "if": {
    "not": {
      "required": ["sections"]
    }
  },
  "then": {
    "properties": {
      "variants": {
        "maxItems": 12
      }
    }
  }
}
