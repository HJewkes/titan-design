{
  "name": "@titan-design/review-harness",
  "version": "0.1.0",
  "private": true,
  "description": "titan-review: a local design-review page over Storybook (round manifest to feedback JSON)",
  "author": "Henry Jewkes",
  "license": "MIT",
  "type": "module",
  "bin": {
    "titan-review": "./src/cli.ts"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "review": "node src/cli.ts",
    "lint": "eslint src page test e2e",
    "type-check": "tsc --noEmit",
    "format:check": "prettier --check \"{src,page,test,e2e}/**/*.{ts,tsx,css,html}\" \"*.{json,md}\"",
    "test": "vitest",
    "test:e2e": "playwright test",
    "schema": "node src/write-json-schema.ts"
  },
  "dependencies": {
    "@playwright/test": "^1.58.2",
    "@titan-design/react-ui": "workspace:*",
    "@vitejs/plugin-react": "^4.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "vite": "^6.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.0.10",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "prettier": "^3.8.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.55.0",
    "vitest": "^2.1.0"
  }
}
