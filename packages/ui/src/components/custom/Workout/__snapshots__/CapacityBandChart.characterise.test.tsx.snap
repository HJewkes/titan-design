exports[`CapacityBandChart characterisation (no loading, error or disabled state) > on a dark surface > renders one workout unchanged > animated 1`] = `
<div>
  <div
    class="css-view-175oi2r"
    style="background-color: rgb(37, 35, 33);"
  >
    <div
      class="css-view-175oi2r"
      data-testid="capacity-band-chart-root"
      style="width: 340px; height: 200px; position: relative;"
    >
      <div
        aria-label="Training capacity band chart. Current capacity: within range. 1 workout shown."
        class="css-view-175oi2r"
