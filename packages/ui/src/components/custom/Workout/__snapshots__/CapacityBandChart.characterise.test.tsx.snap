exports[`CapacityBandChart characterisation (no loading, error or disabled state) > on a light surface > renders the SparseData story unchanged > animated 1`] = `
<div>
  <div
    class="css-view-175oi2r"
    style="background-color: rgb(255, 255, 255);"
  >
    <div
      class="css-view-175oi2r"
      data-testid="capacity-band-chart-root"
      style="width: 300px; height: 180px; position: relative;"
    >
      <div
        aria-label="Training capacity band chart. Current capacity: above range. 2 workouts shown."
        class="css-view-175oi2r"
        data-testid="capacity-band-chart"
        role="img"
        style="position: absolute; top: 0px; left: 0px; width: 300px; height: 180px;"
      >
        <div
          class="css-view-175oi2r"
          data-testid="capacity-band-chart-reveal"
          style="position: absolute; top: 0px; left: 0px; height: 180px; overflow-x: hidden; overflow-y: hidden; width: 300px;"
        >
          <div
            class="css-view-175oi2r"
            style="width: 300px; height: 180px; position: relative;"
          >
            <div
              class="css-view-175oi2r"
              data-testid="capacity-band-chart-band"
            >
              <div
