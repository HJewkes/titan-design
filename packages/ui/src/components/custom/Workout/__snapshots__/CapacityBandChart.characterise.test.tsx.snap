exports[`CapacityBandChart characterisation (no loading, error or disabled state) > on a light surface > renders a band without workouts unchanged > animated 1`] = `
<div>
  <div
    class="css-view-175oi2r"
    style="background-color: rgb(255, 255, 255);"
  >
    <div
      class="css-view-175oi2r"
      data-testid="capacity-band-chart-root"
      style="width: 340px; height: 200px; position: relative;"
    >
      <div
        aria-label="Training capacity band chart. Current capacity: no recent sessions. 0 workouts shown."
        class="css-view-175oi2r"
        data-testid="capacity-band-chart"
        role="img"
        style="position: absolute; top: 0px; left: 0px; width: 340px; height: 200px;"
      >
        <div
          class="css-view-175oi2r"
          data-testid="capacity-band-chart-reveal"
          style="position: absolute; top: 0px; left: 0px; height: 200px; overflow-x: hidden; overflow-y: hidden; width: 340px;"
        >
          <div
            class="css-view-175oi2r"
            style="width: 340px; height: 200px; position: relative;"
          >
            <div
              class="css-view-175oi2r"
              data-testid="capacity-band-chart-band"
            >
              <div
                class="css-view-175oi2r"
                data-testid="capacity-band-chart-band-cell"
                style="position: absolute; left: 28px; top: 90.76190476190474px; width: 4.5px; height: 78.57142857142857px; background-color: rgba(41, 135, 50, 0.1);"
              />
              <div
