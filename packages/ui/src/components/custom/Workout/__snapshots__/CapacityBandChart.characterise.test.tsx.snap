exports[`CapacityBandChart characterisation (no loading, error or disabled state) > on a light surface > renders the Default story unchanged > animated 1`] = `
<div>
  <div
    class="css-view-175oi2r"
    style="background-color: rgb(255, 255, 255);"
  >
    <div
      class="css-view-175oi2r"
      data-testid="capacity-band-chart-root"
      style="width: 340px; height: 200px; position: relative;"
    >
      <div
        aria-label="Training capacity band chart. Current capacity: above range. 6 workouts shown."
