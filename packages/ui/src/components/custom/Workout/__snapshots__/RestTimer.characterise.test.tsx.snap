      data-testid="rest-timer"
    >
      <div
        aria-label="Rest timer, 120 seconds remaining"
        class="css-view-175oi2r"
        data-testid="rest-timer-ring"
        role="timer"
        style="align-items: center; gap: 16px;"
      >
        <div
          aria-label="Timer ring"
          class="css-view-175oi2r"
          data-testid="circular-timer-ring"
          role="progressbar"
          style="width: 180px; height: 180px;"
        >
          <div
            class="css-view-175oi2r"
            style="width: 180px; height: 180px;"
          >
            <svg
              height="100%"
              style="position: absolute;"
              viewBox="0 0 180 180"
              width="100%"
            >
              <circle
                cx="90"
                cy="90"
                fill="none"
                r="86"
                stroke="var(--color-hairline-default)"
                stroke-width="8"
              />
              <circle
                cx="90"
                cy="90"
                fill="none"
                r="86"
                stroke="var(--color-brand-primary)"
                stroke-dasharray="540.3539364174444"
                stroke-dashoffset="108.07078728348887"
                stroke-linecap="round"
                stroke-width="8"
                style="transition: stroke-dashoffset 300ms cubic-bezier(0.22, 1, 0.36, 1);"
                transform="rotate(-90 90 90)"
              />
            </svg>
          </div>
          <div
            class="css-view-175oi2r"
            style="position: absolute; align-items: center; justify-content: center; pointer-events: none;"
          >
            <div
              class="css-text-146c3p1"
              data-testid="circular-timer-label"
              dir="auto"
              style="font-size: 43px; font-family: "Space Grotesk", sans-serif; font-weight: 800; letter-spacing: -1px;"
            >
              2:00
