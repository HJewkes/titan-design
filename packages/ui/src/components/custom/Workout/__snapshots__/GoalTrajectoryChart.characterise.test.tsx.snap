exports[`GoalTrajectoryChart characterisation > on a dark surface > renders the calibrating with a note and a next target fixture unchanged 1`] = `
<div>
  <div
    class="css-view-175oi2r"
    style="background-color: rgb(37, 35, 33);"
  >
    <div
      class="css-view-175oi2r"
      data-testid="goal-trajectory-chart"
      style="width: 360px;"
    >
      <div
        aria-label="CABLE CHEST PRESS trajectory chart. Status: Calibrating. Committed 128 lbs, stretch 128 lbs. Latest 110 lbs at week 2. 0 personal records. Waiting on two more matched sessions. The line is the planned ramp from the start lift, not an expected band."
        class="css-view-175oi2r"
        data-testid="goal-trajectory-chart-canvas"
        role="img"
        style="width: 360px; height: 220px;"
      >
        <svg
          aria-hidden="true"
          height="220"
          viewBox="0 0 360 220"
          width="360"
        >
          <defs>
            <filter
              height="180%"
              id="gtc-shadow-r8n"
              width="110%"
              x="-5%"
              y="-40%"
            >
              <fedropshadow
                dx="0"
                dy="2"
                flood-color="rgba(0, 0, 0, 0.50)"
                flood-opacity="0.9"
                stdDeviation="3"
              />
            </filter>
            <lineargradient
              id="gtc-top-r8n"
              x1="0"
              x2="0"
              y1="0"
              y2="1"
            >
              <stop
                offset="0"
                stop-color="rgba(0, 0, 0, 0.50)"
                stop-opacity="0.44"
              />
              <stop
                offset="0.12"
                stop-color="rgba(0, 0, 0, 0.50)"
                stop-opacity="0"
              />
            </lineargradient>
            <lineargradient
              id="gtc-left-r8n"
              x1="0"
              x2="1"
              y1="0"
              y2="0"
            >
              <stop
                offset="0"
                stop-color="rgba(0, 0, 0, 0.50)"
                stop-opacity="0.32"
              />
              <stop
                offset="0.04"
                stop-color="rgba(0, 0, 0, 0.50)"
                stop-opacity="0"
              />
            </lineargradient>
            <clippath
              id="gtc-clip-r8n"
            >
              <rect
                height="192"
                rx="6"
                width="336"
                x="12"
                y="8"
              />
            </clippath>
