exports[`GoalTrajectoryChart characterisation > on a dark surface > renders the goal met fixture unchanged 1`] = `
<div>
  <div
    class="css-view-175oi2r"
    style="background-color: rgb(37, 35, 33);"
  >
    <div
      class="css-view-175oi2r"
      data-testid="goal-trajectory-chart"
      style="width: 1200px;"
    >
      <div
        aria-label="Bench top load at 8 reps trajectory chart. Status: Goal met. Committed 185 lbs, stretch 195 lbs. Latest 184 lbs at week 4. 1 personal record."
        class="css-view-175oi2r"
        data-testid="goal-trajectory-chart-canvas"
        role="img"
        style="width: 1200px; height: 340px;"
      >
        <svg
          aria-hidden="true"
          height="340"
          viewBox="0 0 1200 340"
          width="1200"
        >
          <defs>
            <filter
              height="180%"
              id="gtc-shadow-r96"
              width="110%"
              x="-5%"
              y="-40%"
            >
              <fedropshadow
                dx="0"
                dy="2"
                flood-color="rgba(0, 0, 0, 0.50)"
                flood-opacity="0.9"
                stdDeviation="3"
              />
            </filter>
            <lineargradient
              id="gtc-top-r96"
              x1="0"
              x2="0"
              y1="0"
              y2="1"
            >
              <stop
                offset="0"
                stop-color="rgba(0, 0, 0, 0.50)"
                stop-opacity="0.44"
              />
              <stop
                offset="0.12"
                stop-color="rgba(0, 0, 0, 0.50)"
                stop-opacity="0"
              />
            </lineargradient>
            <lineargradient
              id="gtc-left-r96"
              x1="0"
              x2="1"
              y1="0"
              y2="0"
            >
              <stop
                offset="0"
                stop-color="rgba(0, 0, 0, 0.50)"
                stop-opacity="0.32"
              />
              <stop
                offset="0.04"
                stop-color="rgba(0, 0, 0, 0.50)"
                stop-opacity="0"
              />
            </lineargradient>
            <clippath
              id="gtc-clip-r96"
            >
              <rect
                height="312"
                rx="6"
                width="1176"
                x="12"
