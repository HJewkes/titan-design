            data-testid="goal-trajectory-chart-canvas"
            role="img"
            style="width: 1200px; height: 340px;"
          >
            <svg
              aria-hidden="true"
              height="340"
              viewBox="0 0 1200 340"
              width="1200"
            >
              <defs>
                <filter
                  height="180%"
                  id="gtc-shadow-r29"
                  width="110%"
                  x="-5%"
                  y="-40%"
                >
                  <fedropshadow
                    dx="0"
                    dy="2"
                    flood-color="rgba(0, 0, 0, 0.50)"
                    flood-opacity="0.9"
