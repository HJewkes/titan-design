exports[`GoalTrajectoryChart characterisation > on a dark surface > renders the ExploreBaselineInsetRule story unchanged 1`] = `
<div>
  <div
    class="css-view-175oi2r"
    style="background-color: rgb(37, 35, 33);"
  >
    <div
      class="css-view-175oi2r"
