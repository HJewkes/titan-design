exports[`GoalTrajectoryChart characterisation > on a dark surface > renders the LossGoalBodyweight story unchanged 1`] = `
<div>
  <div
    class="css-view-175oi2r"
    style="background-color: rgb(37, 35, 33);"
  >
    <div
      class="css-view-175oi2r"
      style="background-color: rgb(37, 35, 33);"
    >
      <div
        class="css-view-175oi2r"
        style="background-color: rgb(44, 42, 40); box-shadow: inset 0 1px 0 rgba(255,255,255,0.12), 0 1px 2px rgba(0,0,0,0.35), 0 2px 6px rgba(0,0,0,0.30);"
      >
        <div
          class="css-view-175oi2r"
          data-testid="goal-trajectory-chart"
          style="width: 1200px;"
        >
          <div
            aria-label="Bodyweight trajectory chart. Status: On track. Committed 193 lbs, stretch 188 lbs. Latest 195 lbs at week 4. 0 personal records."
