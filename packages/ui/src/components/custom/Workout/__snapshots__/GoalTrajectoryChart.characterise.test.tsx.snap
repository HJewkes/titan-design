exports[`GoalTrajectoryChart characterisation > on a light surface > renders the Calibrating story unchanged 1`] = `
<div>
  <div
    class="css-view-175oi2r"
    style="background-color: rgb(255, 255, 255);"
  >
    <div
      class="css-view-175oi2r"
      style="background-color: rgb(255, 255, 255);"
    >
      <div
        class="css-view-175oi2r"
        style="background-color: rgb(249, 246, 243); box-shadow: inset 0 1px 0 rgba(255,255,255,0.90), 0 1px 2px rgba(0,0,0,0.14), 0 2px 6px rgba(0,0,0,0.12);"
      >
        <div
          class="css-view-175oi2r"
          data-testid="goal-trajectory-chart"
          style="width: 1200px;"
        >
          <div
            aria-label="Bench top load at 8 reps trajectory chart. Status: Calibrating. Committed 185 lbs, stretch 195 lbs. Latest 176 lbs at week 2. 0 personal records. No band yet. The line is the planned ramp from the start lift, not an expected band."
            class="css-view-175oi2r"
            data-testid="goal-trajectory-chart-canvas"
            role="img"
            style="width: 1200px; height: 340px;"
          >
            <svg
              aria-hidden="true"
              height="340"
              viewBox="0 0 1200 340"
              width="1200"
            >
              <defs>
                <filter
                  height="180%"
                  id="gtc-shadow-rc0"
                  width="110%"
                  x="-5%"
                  y="-40%"
                >
                  <fedropshadow
                    dx="0"
                    dy="2"
                    flood-color="rgba(0, 0, 0, 0.50)"
                    flood-opacity="0.9"
                    stdDeviation="3"
                  />
                </filter>
                <lineargradient
                  id="gtc-top-rc0"
                  x1="0"
                  x2="0"
                  y1="0"
                  y2="1"
                >
                  <stop
                    offset="0"
                    stop-color="rgba(0, 0, 0, 0.50)"
                    stop-opacity="0.44"
                  />
                  <stop
                    offset="0.12"
                    stop-color="rgba(0, 0, 0, 0.50)"
                    stop-opacity="0"
                  />
                </lineargradient>
                <lineargradient
                  id="gtc-left-rc0"
                  x1="0"
                  x2="1"
                  y1="0"
                  y2="0"
                >
                  <stop
                    offset="0"
                    stop-color="rgba(0, 0, 0, 0.50)"
                    stop-opacity="0.32"
                  />
                  <stop
                    offset="0.04"
                    stop-color="rgba(0, 0, 0, 0.50)"
                    stop-opacity="0"
                  />
                </lineargradient>
                <clippath
                  id="gtc-clip-rc0"
                >
                  <rect
                    height="312"
                    rx="6"
                    width="1176"
