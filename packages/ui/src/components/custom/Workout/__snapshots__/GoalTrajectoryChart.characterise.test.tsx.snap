                    offset="0"
                    stop-color="rgba(0, 0, 0, 0.50)"
                    stop-opacity="0.44"
                  />
                  <stop
                    offset="0.12"
                    stop-color="rgba(0, 0, 0, 0.50)"
                    stop-opacity="0"
                  />
                </lineargradient>
                <lineargradient
                  id="gtc-left-r29"
                  x1="0"
                  x2="1"
                  y1="0"
                  y2="0"
                >
                  <stop
                    offset="0"
                    stop-color="rgba(0, 0, 0, 0.50)"
                    stop-opacity="0.32"
                  />
                  <stop
                    offset="0.04"
                    stop-color="rgba(0, 0, 0, 0.50)"
