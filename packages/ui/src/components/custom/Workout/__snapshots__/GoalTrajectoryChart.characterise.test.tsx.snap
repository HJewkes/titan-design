exports[`GoalTrajectoryChart characterisation > on a light surface > renders the ExploreBandStraight story unchanged 1`] = `
<div>
  <div
    class="css-view-175oi2r"
    style="background-color: rgb(255, 255, 255);"
  >
    <div
      class="css-view-175oi2r"
      style="background-color: rgb(255, 255, 255);"
    >
      <div
        class="css-view-175oi2r"
        style="background-color: rgb(249, 246, 243); box-shadow: inset 0 1px 0 rgba(255,255,255,0.90), 0 1px 2px rgba(0,0,0,0.14), 0 2px 6px rgba(0,0,0,0.12);"
      >
        <div
          class="css-view-175oi2r"
          data-testid="goal-trajectory-chart"
          style="width: 1200px;"
        >
          <div
            aria-label="Bench top load at 8 reps trajectory chart. Status: On track. Committed 185 lbs, stretch 195 lbs. Latest 184 lbs at week 4. 1 personal record."
            class="css-view-175oi2r"
            data-testid="goal-trajectory-chart-canvas"
            role="img"
            style="width: 1200px; height: 340px;"
          >
            <svg
              aria-hidden="true"
              height="340"
              viewBox="0 0 1200 340"
              width="1200"
            >
              <defs>
                <filter
                  height="180%"
                  id="gtc-shadow-req"
                  width="110%"
                  x="-5%"
                  y="-40%"
                >
                  <fedropshadow
