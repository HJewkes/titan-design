exports[`DualGhostSpark characterisation > on a dark surface > renders the AsymmetricLeftRight story unchanged 1`] = `
<div>
  <div
    class="css-view-175oi2r"
    style="background-color: rgb(37, 35, 33);"
  >
    <div
      class="css-view-175oi2r"
      style="background-color: rgb(16, 13, 10); padding: 28px 28px 28px 28px; gap: 24px; flex-direction: row; flex-wrap: wrap; align-items: flex-start;"
    >
      <div
        class="css-view-175oi2r"
        style="gap: 8px; align-items: flex-start;"
      >
        <div
          class="css-text-146c3p1"
          dir="auto"
          style="font-size: 9px; letter-spacing: 1px; font-family: monospace, monospace; color: rgb(136, 134, 132);"
        >
          ASYMMETRIC · LEFT SILVER · RIGHT GRINDING RED
        </div>
        <div
          class="css-view-175oi2r"
          style="width: 400px; background-color: rgb(28, 25, 22); border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-right-radius: 12px; border-bottom-left-radius: 12px; padding: 16px 16px 16px 16px;"
        >
          <div
            aria-label="Rep 3 of 3, left peak 1.40 m/s, right peak 0.69 m/s"
            class="css-view-175oi2r"
