        </div>
        <div
          class="css-view-175oi2r"
        >
          <div
            class="css-text-146c3p1"
            dir="auto"
          >
            /* Button base */
padding: 6px 16px;
border-radius: 4px;
display: flex;
align-items: center;

/* Active (isActive !== false) - sunken look */
background-color: #3C3C3C;
box-shadow: inset -1px -1px 6px #3C3C3C,
            inset 1px 2px 1px #6E6E6E,
            1px 1px 1px #6E6E6E;
color: #FFFFFF;

/* Inactive (isActive === false) - elevated look */
background-color: #6E6E6E;
box-shadow: inset 2px 2px 2px #1F1F1F,
            inset -1px -1px 2px #6E6E6E;
color: #D1D1D1;

/* Text (Typography subtitle2 + bold) */
font-size: 14px;
font-weight: 700;
font-family: Nunito Sans;
line-height: 1.57;

/* Icon */
width: 20px;
height: 20px;
margin-right: 8px; /* when label shown */
color: #FF7900; /* when isActive=true */
          </div>
        </div>
        <div
          class="css-view-175oi2r"
          style="flex-direction: row; gap: 8px;"
        >
          <div
            class="css-view-175oi2r"
          >
            <button
