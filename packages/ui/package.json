{
  "name": "@titan-design/react-ui",
  "version": "0.21.2",
  "description": "Cross-platform design system built on Gluestack UI",
  "author": "Henry Jewkes",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/HJewkes/titan-design.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/HJewkes/titan-design",
  "bugs": {
    "url": "https://github.com/HJewkes/titan-design/issues"
  },
  "source": "./src/index.ts",
  "react-native": "./src/index.ts",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./bodymap": {
      "react-native": "./src/bodymap.ts",
      "import": {
        "types": "./dist/bodymap.d.mts",
        "default": "./dist/bodymap.mjs"
      },
      "require": {
        "types": "./dist/bodymap.d.ts",
        "default": "./dist/bodymap.js"
      }
    },
    "./pages": {
      "react-native": "./src/pages.ts",
      "import": {
        "types": "./dist/pages.d.mts",
        "default": "./dist/pages.mjs"
      },
      "require": {
        "types": "./dist/pages.d.ts",
        "default": "./dist/pages.js"
      }
    },
    "./theme": {
      "react-native": "./src/theme/index.ts",
      "import": {
        "types": "./dist/theme/index.d.mts",
        "default": "./dist/theme/index.mjs"
      },
      "require": {
        "types": "./dist/theme/index.d.ts",
        "default": "./dist/theme/index.js"
      }
    },
    "./theme/tokens": {
      "react-native": "./src/theme/tokens/index.ts",
      "import": {
        "types": "./dist/theme/tokens.d.mts",
        "default": "./dist/theme/tokens.mjs"
      },
      "require": {
        "types": "./dist/theme/tokens.d.ts",
        "default": "./dist/theme/tokens.js"
      }
    },
    "./theme/tokens-css": {
      "import": {
        "types": "./dist/theme/tokens-css.d.mts",
        "default": "./dist/theme/tokens-css.mjs"
      },
      "require": {
        "types": "./dist/theme/tokens-css.d.ts",
        "default": "./dist/theme/tokens-css.js"
      }
    },
    "./theme/global.css": "./src/theme/global.css",
    "./tokens.css": "./dist/tokens.css",
    "./tailwind.config.js": "./tailwind.config.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsup && node scripts/generate-tokens-css.mjs",
    "dev": "tsup --watch",
    "lint": "eslint src/ scripts/ --max-warnings 0 && pnpm lint:borders",
    "lint:borders": "bash scripts/check-border-classes.sh",
    "check:package": "bash scripts/check-package.sh",
    "check:cycles": "node scripts/check-cycles.mjs",
    "api:check": "node scripts/api-report.mjs",
    "api:update": "node scripts/api-report.mjs --local",
    "docs:check": "node scripts/check-doc-examples.mjs",
    "size": "size-limit",
    "catalog": "node scripts/catalog.mjs",
    "changelog:compile": "node scripts/changelog-compile.mjs",
    "type-check": "tsc --noEmit",
    "type-check:examples": "node scripts/check-examples-types.mjs",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest --project threads --project local-time --project types --project stories-axe",
    "test:unit": "vitest --project threads --project local-time --project types",
    "test:unit:ci": "vitest run --coverage --project threads --project local-time --project types",
    "test:axe": "vitest run --project stories-axe",
    "test:storybook": "vitest run --project storybook --reporter=default --reporter=json --outputFile.json=.vitest-storybook-report.json && node scripts/check-play-count.mjs .vitest-storybook-report.json",
    "test:coverage": "vitest --project threads --project local-time --project types --project stories-axe --coverage",
    "storybook": "node scripts/storybook-launch.mjs",
    "build-storybook": "storybook build",
    "test:mutation": "stryker run && node scripts/check-mutation-report.mjs",
    "test:visual": "playwright test --project=chromium",
    "test:visual:update": "playwright test --project=chromium --update-snapshots",
    "extract-css": "node scripts/extract-css-properties.mjs",
    "design-freeze": "node scripts/design-freeze.mjs",
    "specimen": "vite --config specimen/vite.config.ts",
    "specimen:compare": "vite --config specimen/vite.config.ts --open /comparison.html",
    "test:visual:compare": "playwright test --config playwright.comparison.config.ts",
    "test:visual:baseline": "playwright test --config playwright.baseline.config.ts",
    "test:visual:baseline:update": "playwright test --config playwright.baseline.config.ts --update-snapshots",
    "test:visual:tokens": "playwright test --config playwright.tokens.config.ts",
    "test:visual:stories": "playwright test stories.spec.ts",
    "test:visual:stories:update": "playwright test stories.spec.ts --update-snapshots",
    "test:visual:contrast": "playwright test --config playwright.contrast.config.ts",
    "test:visual:contrast:update": "node scripts/update-contrast-stories-baseline.mjs",
    "test:offline-fonts": "playwright test --config playwright.offline-fonts.config.ts",
    "test:audit-probes": "playwright test --config playwright.audit-probes.config.ts",
    "prepublishOnly": "node scripts/ci-only-publish.mjs && pnpm build && vitest --run --project threads --project local-time --project types --project stories-axe",
    "lint:colors:baseline": "node scripts/update-raw-color-baseline.mjs",
    "storybook:isolated": "node scripts/storybook-launch.mjs --isolated",
    "storybook:ports": "node scripts/storybook-launch.mjs --list",
    "storybook:reap": "node scripts/storybook-launch.mjs --reap --list",
    "storybook:reap:all": "node scripts/storybook-launch.mjs --reap=all --list",
    "audit:stories": "node scripts/audit-stories.mjs"
  },
  "peerDependencies": {
    "nativewind": "^4.2.1",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-native": ">=0.72.0",
    "react-native-body-highlighter": ">=3.0.0",
    "react-native-svg": ">=15.0.0",
    "react-native-web": ">=0.19.0"
  },
  "peerDependenciesMeta": {
    "nativewind": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-native-body-highlighter": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    },
    "react-native-web": {
      "optional": true
    }
  },
  "dependencies": {
    "@titan-design/chat-protocol": "0.1.0",
    "clsx": "^2.1.0",
    "d3-force": "^3",
    "d3-scale": "^4",
    "d3-shape": "^3",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "7.59.3",
    "@playwright/test": "^1.58.2",
    "@size-limit/file": "^12.1.0",
    "@storybook/addon-a11y": "^10.2.0",
    "@storybook/addon-docs": "^10.2.0",
    "@storybook/addon-react-native-web": "^0.0.29",
    "@storybook/addon-themes": "^10.2.0",
    "@storybook/addon-vitest": "10.2.0",
    "@storybook/react-native-web-vite": "^10.2.0",
    "@storybook/react-vite": "^10.2.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@types/d3-force": "^3",
    "@types/d3-scale": "^4",
    "@types/d3-shape": "^3",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/browser": "3.2.7",
    "@vitest/coverage-v8": "^3.2.6",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "fast-check": "^3.23.2",
    "globals": "^14.0.0",
    "jest-axe": "^9.0.0",
    "jsdom": "^25.0.0",
    "madge": "8.0.0",
    "nativewind": "^4.2.1",
    "prettier": "^3.8.1",
    "publint": "0.3.24",
    "react": "^18.3.0",
    "react-docgen-typescript": "2.4.0",
    "react-dom": "^18.3.0",
    "react-hook-form": "^7.54.2",
    "react-native-body-highlighter": "^3.2.0",
    "react-native-svg": "^15.15.5",
    "react-native-web": "^0.19.0",
    "size-limit": "^12.1.0",
    "storybook": "^10.2.0",
    "tailwindcss": "^3.4.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.55.0",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "2.2.0",
    "vitest": "^3.2.6"
  },
  "files": [
    "dist",
    "src",
    "!src/lab",
    "!src/**/ROUND-*.md",
    "!src/**/*.png",
    "docs",
    "tailwind.config.js",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "keywords": [
    "design-system",
    "react",
    "react-native",
    "tailwind",
    "ui-components"
  ]
}
