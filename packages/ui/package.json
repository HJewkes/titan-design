{
  "name": "@titan-design/react-ui",
  "version": "0.1.0",
  "description": "Cross-platform design system built on Gluestack UI",
  "author": "Henry Jewkes",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/HJewkes/titan-design.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/HJewkes/titan-design",
  "bugs": {
    "url": "https://github.com/HJewkes/titan-design/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme/index.mjs",
      "require": "./dist/theme/index.js"
    },
    "./theme/global.css": "./src/theme/global.css"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/",
    "type-check": "tsc --noEmit",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepublishOnly": "tsup && vitest --run"
  },
  "peerDependencies": {
    "lucide-react": ">=0.400.0",
    "lucide-react-native": ">=0.400.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-native": ">=0.72.0",
    "react-native-web": ">=0.19.0"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    },
    "react-native-web": {
      "optional": true
    },
    "lucide-react-native": {
      "optional": true
    }
  },
  "dependencies": {
    "@gluestack-style/react": "^1.0.0",
    "@gluestack-ui/themed": "^1.1.0",
    "clsx": "^2.1.0",
    "nativewind": "^4.1.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.2.0",
    "@storybook/addon-docs": "^10.2.0",
    "@storybook/addon-react-native-web": "^0.0.29",
    "@storybook/addon-themes": "^10.2.0",
    "@storybook/react": "^10.2.0",
    "@storybook/react-native-web-vite": "^10.2.0",
    "@storybook/react-vite": "^10.2.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^2.1.0",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jest-axe": "^9.0.0",
    "jsdom": "^25.0.0",
    "lucide-react": "^0.469.0",
    "prettier": "^3.8.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-native-web": "^0.19.0",
    "storybook": "^10.2.0",
    "tailwindcss": "^3.4.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.55.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  },
  "files": [
    "dist",
    "src/theme/global.css",
    "tailwind.config.js"
  ],
  "sideEffects": false,
  "keywords": [
    "design-system",
    "react",
    "react-native",
    "tailwind",
    "ui-components"
  ]
}
